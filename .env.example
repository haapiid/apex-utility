# ===== 🐒 ApeX Utility — Environment (Solana) =====

# Bot token from @BotFather
BOT_TOKEN=

# Secret used to encrypt user private keys in data/wallets.json (min. 32 random chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Never change or lose this after launch — stored wallets can't be decrypted without it.
WALLET_SECRET=

# Solana wallet that receives the bot trading fee (revenue). Leave empty to disable fees.
TREASURY_ADDRESS=

# Solana RPC. The public endpoint is heavily rate-limited — use a private RPC
# (Helius, QuickNode, Triton, ...) for launch.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
EXPLORER_URL=https://solscan.io

# Jupiter aggregator API (swaps, token info, prices). lite-api is the free tier.
JUPITER_API_URL=https://lite-api.jup.ag

# Max slippage in basis points (500 = 5%)
SLIPPAGE_BPS=500
# Max priority fee per swap in lamports (1,000,000 = 0.001 SOL)
PRIORITY_FEE_MAX_LAMPORTS=1000000

# ----- EVM chains (Ethereum, BSC, Base, HyperEVM, MegaETH, Robinhood) -----
# One EVM wallet per user works on every chain. Swaps are routed through KyberSwap (no API key needed).

# EVM wallet that receives the bot trading fee on every EVM chain. Leave empty to disable EVM fees.
EVM_TREASURY_ADDRESS=

# Max slippage on EVM swaps in basis points (defaults to SLIPPAGE_BPS, max 2000)
# EVM_SLIPPAGE_BPS=500

# Identifies the bot to KyberSwap; requests without it get stricter rate limits
KYBER_CLIENT_ID=apex-utility
# KYBER_API_URL=https://aggregator-api.kyberswap.com

# RPC per chain. The defaults below are public and rate-limited: use private RPCs
# (Alchemy, QuickNode, dRPC, Ankr, ...) for launch.
# ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# BSC_RPC_URL=https://bsc-rpc.publicnode.com
# BASE_RPC_URL=https://mainnet.base.org
# HYPEREVM_RPC_URL=https://rpc.hyperliquid.xyz/evm
# MEGAETH_RPC_URL=https://mainnet.megaeth.com/rpc
# ROBINHOOD_RPC_URL=https://robinhood.drpc.org
# Stable is listed as "coming soon" (no swap aggregator supports it yet)
# STABLE_RPC_URL=https://rpc.stable.xyz

# ----- Trading fees -----
# Trading fee per trade type, in basis points (50 = 0.5%)
FEE_MANUAL_BPS=50
FEE_SNIPE_BPS=100
# Limit orders, DCA and copy trades
FEE_AUTO_BPS=50
# Solana fees are taken inside the swap once the treasury's wSOL account exists:
#   SETUP_PAYER_KEY=<base58 key of any funded wallet> npm run setup:fee-account

# ----- pump.fun sniper -----
# Feed of new pump.fun tokens and migrations (connected only while a pump rule or migration snipe is active)
# PUMP_FEED_URL=wss://pumpportal.fun/api/data

# ----- MEV protection -----
# Solana swaps are sent through Jito with this default tip (users can change it in /settings)
JITO_TIP_LAMPORTS=100000
# JITO_URL=https://mainnet.block-engine.jito.wtf
# Ethereum and BSC send through private RPCs by default; override with e.g.
# ETH_PROTECT_RPC_URL=https://rpc.flashbots.net/fast
# BSC_PROTECT_RPC_URL=https://bscrpc.pancakeswap.finance

# SQLite database (wallets, settings, trades, positions)
# DB_PATH=./data/apex.db

# ----- Revenue share, referral, $APEX -----
# Fee flow: referral cut first, then this share of the rest goes to $APEX holders (4000 = 40%)
REVENUE_SHARE_BPS=4000
# How often the holder pools are distributed
REVENUE_EPOCH_HOURS=24
# Referrers earn this share of the fees paid by the users they invited (2500 = 25%)
REFERRAL_SHARE_BPS=2500
TOKEN_SYMBOL=APEX
# Used by the revenue calculator only
TOKEN_TOTAL_SUPPLY=1000000

# $APEX is not launched yet. Leave empty: revenue pools, referral and cashback keep counting,
# distribution / cashback claims / burning switch on once the address is set.
APEX_TOKEN_CHAIN=sol
APEX_TOKEN_ADDRESS=
# Whole tokens a user must hold (across their ApeX wallets) to earn revenue share
APEX_MIN_HOLD=50
# Cashback in $APEX = fees paid in USD × this (0 - 1)
CASHBACK_MULTIPLIER=0.1
# Burning $APEX gives credits; credits unlock extra wallet slots
BURN_CREDITS_PER_TOKEN=1
EXTRA_WALLET_SLOT_CREDITS=100

# Rewards wallet: pays claims so users don't need gas. Use a NEW wallet, separate from the treasury,
# and only keep what's owed in it (see /admin). Solana: base58 secret key; EVM: 0x hex key.
REWARDS_SOL_PRIVATE_KEY=
REWARDS_EVM_PRIVATE_KEY=

# Telegram user ids allowed to use /admin (comma separated)
ADMIN_IDS=
# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# ----- ApeX Pro (web app, served by the bot process) -----
# Public address of the web app (used in login/referral links and the Google redirect)
WEB_PORT=8080
WEB_PUBLIC_URL=http://localhost:8080
# WEB_ENABLED=false  to run the bot without the web app
# Optional "Continue with Google": OAuth client from Google Cloud Console, authorized redirect URI =
#   WEB_PUBLIC_URL/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
