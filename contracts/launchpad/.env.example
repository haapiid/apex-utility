# Copy to .env (never commit it). Use a fresh wallet that only pays deployment gas.
DEPLOYER_PRIVATE_KEY=

# Receives the fees (same as the bot's EVM_TREASURY_ADDRESS)
EVM_TREASURY_ADDRESS=
# Owner of the launchpad (fees, pause, curve params). Defaults to the deployer; a multisig is better.
LAUNCHPAD_OWNER=

ROBINHOOD_RPC_URL=https://robinhood.drpc.org
ROBINHOOD_TESTNET_RPC_URL=https://robinhood-testnet.drpc.org

# Optional: an existing Uniswap V2 on the target chain (mainnet defaults are built in)
LAUNCHPAD_V2_FACTORY=
LAUNCHPAD_WETH=

# Optional curve shape (defaults = pump.fun's ratios scaled to ETH: graduates at ~4.25 ETH raised)
LAUNCHPAD_VIRTUAL_ETH=1.5
LAUNCHPAD_VIRTUAL_TOKENS=1073000000
LAUNCHPAD_CURVE_TOKENS=793100000

# Optional fees (only applied when the deployer is the owner)
LAUNCHPAD_TRADE_FEE_BPS=100
LAUNCHPAD_CREATOR_FEE_BPS=0
LAUNCHPAD_GRADUATION_FEE_BPS=200
LAUNCHPAD_CREATE_FEE=0
