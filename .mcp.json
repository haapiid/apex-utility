{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83", "--browser", "msedge"]
    },
    "huggingface": {
      "type": "http",
      "url": "https://huggingface.co/mcp?login"
    },
    "nano-banana": {
      "command": "npx",
      "args": ["-y", "nano-banana-mcp@1.0.3"],
      "env": {
        "GEMINI_API_KEY": "${GEMINI_API_KEY:-}"
      }
    }
  }
}
